/* 组件样式独立，不依赖页面的 btn-* / card 类。
   定位目标：和页面里的说明文字同级，不能比主操作更抢眼。 */
.cb-root {
    display: block;
    text-align: center;
}

.cb-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin: 0;
    padding: 16rpx 24rpx;
    border: none;
    background: transparent;
    color: #9C9284;
    font-size: 24rpx;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    overflow: visible;
}

.cb-button::after {
    border: none;
}

.cb-hover {
    opacity: 0.6;
}

.cb-link-text {
    line-height: 1.4;
}

.cb-link-arrow {
    margin-left: 8rpx;
    font-size: 26rpx;
    line-height: 1;
    color: #C4BAAA;
}
