<!-- 反馈入口：一行文字，open-type="contact" 由微信原生唤起客服会话 -->
<view class="cb-root">
    <button
        class="cb-button"
        open-type="contact"
        session-from="{{sessionFrom}}"
        send-message-title="{{messageTitle}}"
        send-message-path="{{messagePath}}"
        show-message-card="{{true}}"
        bindcontact="onContact"
        bindtap="onTap"
        hover-class="cb-hover"
    >
        <text class="cb-link-text">{{text}}</text>
        <text class="cb-link-arrow">›</text>
    </button>
</view>
