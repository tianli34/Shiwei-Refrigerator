.login {
    padding: 36rpx 32rpx;
    background: #FFFFFF;
    border-radius: 32rpx;
    box-shadow: 0 10rpx 30rpx rgba(126, 110, 74, 0.08);
}

.login-title {
    display: block;
    font-size: 34rpx;
    font-weight: 700;
    color: #4A4036;
}

.login-desc {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #9C9284;
}

.login-wechat {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 36rpx;
    height: 92rpx;
    line-height: 92rpx;
    font-size: 30rpx;
    font-weight: 700;
    color: #FFFFFF;
    background: #7FB069;
    border-radius: 22rpx;
    box-shadow: 0 8rpx 20rpx rgba(127, 176, 105, 0.24);
}

.login-wechat::after {
    border: none;
}

.login-wechat-icon {
    margin-right: 12rpx;
    font-size: 34rpx;
}

.login-divider {
    display: flex;
    align-items: center;
    margin-top: 32rpx;
}

.login-divider-line {
    flex: 1;
    height: 1rpx;
    background: #EDE8DA;
}

.login-divider-text {
    padding: 0 24rpx;
    font-size: 24rpx;
    color: #B3A998;
}

.login-switch {
    margin-top: 24rpx;
    text-align: center;
    font-size: 26rpx;
    color: #4E7A3E;
}

.login-input {
    height: 84rpx;
    padding: 0 24rpx;
    margin-top: 28rpx;
    font-size: 28rpx;
    color: #4A4036;
    background: #F4F1E6;
    border-radius: 20rpx;
}

.login-placeholder {
    color: #B3A998;
}

.login-row {
    display: flex;
    align-items: center;
}

.login-code {
    flex: 1;
    margin-top: 20rpx;
}

.login-send {
    flex-shrink: 0;
    margin: 20rpx 0 0 20rpx;
    padding: 0 24rpx;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 26rpx;
    color: #4E7A3E;
    background: #EAF3DF;
    border-radius: 20rpx;
}

.login-send-disabled {
    color: #B3A998;
    background: #F4F1E6;
}

.login-button {
    margin-top: 28rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    font-weight: 700;
    color: #FFFFFF;
    background: #7FB069;
    border-radius: 22rpx;
}

.login-button::after {
    border: none;
}

.login-tip {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #4E7A3E;
}

.login-error {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #D97070;
}

.login-note {
    display: block;
    margin-top: 24rpx;
    padding: 20rpx 22rpx;
    font-size: 23rpx;
    line-height: 1.6;
    color: #8A7F6C;
    background: #FBF7E8;
    border-radius: 18rpx;
}
