<view class="login">
    <text class="login-title">欢迎回到拾味冰箱</text>
    <text class="login-desc">登录后，食材、菜谱和买菜篮会自动同步到你的账号。</text>

    <button
        class="login-wechat"
        loading="{{wechatLoading}}"
        disabled="{{wechatLoading}}"
        bindtap="onWechatLogin"
    >
        <text class="login-wechat-icon">💬</text>
        <text>微信一键登录</text>
    </button>

    <view class="login-divider">
        <view class="login-divider-line"></view>
        <text class="login-divider-text">或</text>
        <view class="login-divider-line"></view>
    </view>

    <view class="login-switch" bindtap="toggleEmail">{{useEmail ? '收起邮箱登录' : '使用邮箱验证码登录'}}</view>

    <block wx:if="{{useEmail}}">
        <input
            class="login-input"
            type="text"
            placeholder="邮箱"
            placeholder-class="login-placeholder"
            value="{{email}}"
            bindinput="onEmailInput"
        />

        <view class="login-row">
            <input
                class="login-input login-code"
                placeholder="验证码"
                placeholder-class="login-placeholder"
                value="{{code}}"
                bindinput="onCodeInput"
                bindconfirm="submit"
            />
            <view
                class="login-send {{sending || countdown > 0 ? 'login-send-disabled' : ''}}"
                bindtap="sendCode"
            >{{countdown > 0 ? countdown + ' 秒后重发' : (sending ? '发送中' : '获取验证码')}}</view>
        </view>

        <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">邮箱登录 / 注册</button>
    </block>

    <text class="login-tip" wx:if="{{tip}}">{{tip}}</text>
    <text class="login-error" wx:if="{{error}}">{{error}}</text>
    <text class="login-note" wx:if="{{previewHint}}">{{previewHint}}</text>
</view>
