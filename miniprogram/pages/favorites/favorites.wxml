<view class="page-wrap">

    <view wx:if="{{authState === 'checking'}}" class="loading-box">
        <text class="loading-dot">📖</text><text>正在翻收藏夹…</text>
    </view>

    <view wx:elif="{{authState === 'signed-out'}}" class="auth-state">
        <view class="auth-head">
            <text class="auth-logo">📖</text>
            <text class="auth-title">我的收藏</text>
            <text class="auth-slogan">登录后才看得见你收藏过的菜</text>
        </view>
        <login-panel bind:signedin="onSignedIn" />
        <text class="auth-error" wx:if="{{authError}}">{{authError}}</text>
    </view>

    <block wx:else>
        <view class="fav-hero">
            <text class="fav-hero-emoji">📖</text>
            <view class="fav-hero-copy">
                <text class="fav-hero-title">我的收藏</text>
                <text class="fav-hero-sub">AI 给你编过的菜都在这儿，下次接着做</text>
            </view>
        </view>

        <view class="loading-box" wx:if="{{viewState === 'loading'}}">
            <text class="loading-dot">🍳</text><text>正在翻收藏夹…</text>
        </view>

        <view class="card" wx:elif="{{viewState === 'error'}}">
            <text class="section-title">收藏没取出来</text>
            <text class="section-sub">检查一下网络，或者稍后重新加载。</text>
            <view class="btn-ghost" style="margin-top:24rpx" bindtap="onRetryData">重新加载</view>
        </view>

        <block wx:else>
            <view class="filter-row">
                <view class="filter-chip {{filter === 'all' ? 'filter-on' : ''}}" data-filter="all" bindtap="onFilterTap">全部 {{counts.all}}</view>
                <view class="filter-chip {{filter === 'ready' ? 'filter-on' : ''}}" data-filter="ready" bindtap="onFilterTap">现在能做 {{counts.ready}}</view>
            </view>

            <block wx:if="{{visible.length > 0}}">
                <view
                    class="fav-card"
                    wx:for="{{visible}}"
                    wx:key="id"
                    data-id="{{item.id}}"
                    bindtap="onCardTap"
                    bindlongpress="onCardLongPress"
                >
                    <text class="fav-emoji">{{item.emoji}}</text>
                    <view class="fav-copy">
                        <view class="fav-head">
                            <text class="fav-name">{{item.name}}</text>
                            <text class="fav-status status-{{item.statusKind}}">{{item.statusText}}</text>
                        </view>
                        <text class="fav-meta">{{item.minutes}} 分钟 · {{item.difficulty}} · {{item.savedText}}</text>
                        <text class="fav-items" wx:if="{{item.mainItemsText}}">用料：{{item.mainItemsText}}</text>
                        <view class="fav-tags" wx:if="{{item.tags.length > 0}}">
                            <text class="fav-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                        </view>
                    </view>
                </view>
                <text class="fav-hint">点开看做法，长按可取消收藏</text>
            </block>

            <view class="empty-state" wx:elif="{{filter === 'ready'}}">
                <text class="empty-emoji">🧺</text>
                <text class="empty-title">冰箱还凑不齐收藏的菜</text>
                <text class="empty-desc">先买齐用料，或者切回「全部」看看别的。</text>
                <view class="btn-ghost" style="margin-top:24rpx" bindtap="onFilterTap" data-filter="all">看全部收藏</view>
            </view>

            <view class="empty-state" wx:else>
                <text class="empty-emoji">✨</text>
                <text class="empty-title">还没收藏过菜</text>
                <text class="empty-desc">在炼金术里让 AI 编一道，点「收藏这道菜」就会存到这里，下次还能直接翻出来做。</text>
                <view class="btn-primary" style="margin-top:28rpx" bindtap="goAlchemy">去炼金术编一道</view>
            </view>
        </block>
    </block>

    <!-- 菜谱详情 -->
    <view class="mask" wx:if="{{detail}}" bindtap="closeDetail"></view>
    <view class="sheet" wx:if="{{detail}}">
        <view class="sheet-handle"></view>
        <text class="detail-emoji">{{detail.emoji}}</text>
        <text class="sheet-title">{{detail.name}}</text>
        <text class="sheet-sub">{{detail.minutes}} 分钟 · {{detail.difficulty}} · {{detail.savedText}}</text>

        <text class="field-label">用料</text>
        <text class="detail-need">{{detail.mainItemsText || '没有记录主料'}}<text wx:if="{{detail.seasoningsText}}">（调料：{{detail.seasoningsText}}）</text></text>

        <text class="field-label">做法</text>
        <view class="detail-step" wx:for="{{detail.steps}}" wx:key="*this">
            <text class="step-no">{{index + 1}}</text>
            <text class="step-text">{{item}}</text>
        </view>

        <text class="detail-tip" wx:if="{{detail.missingText}}">冰箱里还差：{{detail.missingText}}</text>

        <view class="btn-yellow" style="margin-top:28rpx" wx:if="{{detail.missing.length > 0}}" bindtap="onAddMissing">🛒 缺的 {{detail.missing.length}} 样加入买菜篮</view>
        <view class="btn-primary" style="margin-top:20rpx" bindtap="onCookAgain">✨ 用现有食材再合成一次</view>
        <view class="btn-ghost" style="margin-top:16rpx" bindtap="onRemoveTap">取消收藏</view>
    </view>

    <tab-bar current="profile" />
</view>
