<view class="page-wrap">

    <view wx:if="{{authState === 'checking'}}" class="loading-box">
        <text class="loading-dot">🐸</text><text>正在翻小本本…</text>
    </view>

    <view wx:elif="{{authState === 'signed-out'}}" class="auth-state">
        <view class="auth-head">
            <text class="auth-logo">🐸</text>
            <text class="auth-title">欢迎来拾味冰箱</text>
            <text class="auth-slogan">拯救过期食材，专治「今天吃什么」</text>
        </view>
        <login-panel bind:signedin="onSignedIn" />
        <text class="auth-error" wx:if="{{authError}}">{{authError}}</text>
    </view>

    <block wx:else>
        <view class="me-card">
            <text class="me-avatar">🐸</text>
            <view class="me-copy">
                <text class="me-name">{{userLabel}}</text>
                <text class="me-sub">{{householdLabel}}</text>
            </view>
            <text class="me-badge">主厨</text>
        </view>

        <view class="stat-grid">
            <view class="stat">
                <text class="stat-num">{{stats.foods}}</text>
                <text class="stat-label">冰箱食材</text>
            </view>
            <view class="stat">
                <text class="stat-num stat-warn">{{stats.urgent}}</text>
                <text class="stat-label">快过期</text>
            </view>
            <view class="stat">
                <text class="stat-num">{{stats.shopping}}</text>
                <text class="stat-label">待买</text>
            </view>
            <view class="stat stat-link" bindtap="goFavorites">
                <text class="stat-num stat-ai">{{stats.aiRecipes}}</text>
                <text class="stat-label">我的收藏 ›</text>
            </view>
        </view>

        <view class="card">
            <text class="section-title">⏰ 临期提醒</text>
            <text class="section-sub">食材还剩 2 天时，在冰箱首页亮起提醒条。</text>
            <view class="setting-row">
                <text class="setting-label">应用内临期提醒</text>
                <switch checked="{{reminderOn}}" color="#7FB069" bindchange="onReminderChange" />
            </view>
            <view class="setting-row" bindtap="onSubscribeTap">
                <view>
                    <text class="setting-label">微信服务通知</text>
                    <text class="setting-hint">{{subscribeHint}}</text>
                </view>
                <text class="setting-arrow">›</text>
            </view>
        </view>

        <view class="card">
            <text class="section-title">🏷️ 食材叫法</text>
            <text class="section-sub">番茄还是西红柿、土豆还是洋芋，按你的习惯来</text>
            <view class="setting-row" bindtap="onOpenRegion">
                <view>
                    <text class="setting-label">地域叫法</text>
                    <text class="setting-hint">{{nameRegionLabel}} · 点这里切换</text>
                </view>
                <text class="setting-arrow">›</text>
            </view>
            <view class="setting-row">
                <view>
                    <text class="setting-label">全家统一叫法</text>
                    <text class="setting-hint">打开后，改叫法会同步给同一个冰箱的成员</text>
                </view>
                <switch checked="{{nameUnified}}" color="#7FB069" bindchange="onUnifiedChange" />
            </view>
            <view class="setting-row" bindtap="onPreviewNotice">
                <view>
                    <text class="setting-label">提醒文案预览</text>
                    <text class="setting-hint">看看临期提醒里会怎么叫它</text>
                </view>
                <text class="setting-arrow">›</text>
            </view>
            <text class="setting-hint" style="display:block;margin-top:12rpx">已单独设置 {{namePrefCount}} 样 · {{nameSyncHint}}</text>
            <text class="section-sub">在冰箱或买菜篮里点食材名旁的 ✎，可以单独改叫法</text>
        </view>

        <view class="card" bindtap="goFavorites">
            <view class="row-between">
                <text class="section-title">📖 我的收藏</text>
                <text class="setting-arrow">›</text>
            </view>
            <text class="section-sub">{{stats.aiRecipes > 0 ? 'AI 给你编过 ' + stats.aiRecipes + ' 道菜，点开就能翻做法' : '收藏过的菜都存在这里，随时翻出来做'}}</text>
        </view>

        <view class="card" bindtap="goFamily">
            <view class="row-between">
                <text class="section-title">🏡 家庭与点菜板</text>
                <text class="setting-arrow">›</text>
            </view>
            <text class="section-sub">邀请家人共用一个冰箱，把菜单发给朋友点菜</text>
        </view>

        <view class="card" bindtap="goFridge">
            <view class="row-between">
                <text class="section-title">🧊 回到冰箱</text>
                <text class="setting-arrow">›</text>
            </view>
            <text class="section-sub">看看今天先消灭哪一样</text>
        </view>

        <!-- 客服消息入口：点击唤起微信客服会话，可直接给小程序发消息 -->
        <contact-button
            mode="card"
            source="profile"
            title="💬 联系客服 · 提建议"
            desc="食材、菜谱、共享冰箱有问题？点这里直接给小程序发消息"
            bind:contact="onContact"
        />

        <view class="about">
            <text class="about-logo">🧊 拾味冰箱</text>
            <text class="about-slogan">拯救过期食材，专治「今天吃什么」</text>
            <text class="about-version">MVP 1.0 · 治愈系厨房小管家</text>
        </view>

        <view class="btn-ghost" style="margin-top:16rpx" bindtap="onSignOut">退出登录</view>
    </block>

    <tab-bar current="profile" />

    <view class="mask" wx:if="{{showRegionSheet}}" bindtap="onCloseRegion"></view>
    <view class="sheet" wx:if="{{showRegionSheet}}">
        <view class="sheet-handle"></view>
        <text class="sheet-title">选一套你熟悉的叫法</text>
        <text class="sheet-sub">只改变显示，不影响菜谱匹配和冰箱库存</text>
        <view class="setting-row" style="border-bottom:1rpx solid #eef1e9" wx:for="{{nameRegions}}" wx:key="key" data-key="{{item.key}}" bindtap="onPickRegion">
            <view>
                <text class="setting-label" style="display:block">{{item.label}} {{item.on ? '✓' : ''}}</text>
                <text class="setting-hint" style="display:block">{{item.hint}}</text>
            </view>
            <text class="setting-arrow">›</text>
        </view>
        <view class="btn-ghost" style="margin-top:20rpx" bindtap="onCloseRegion">取消</view>
    </view>
</view>
