.me-card {
    display: flex;
    align-items: center;
    padding: 36rpx 32rpx;
    border-radius: 34rpx;
    background: linear-gradient(120deg, #A8C98A, #7FB069);
    box-shadow: 0 12rpx 28rpx rgba(94, 148, 80, 0.24);
}

.me-avatar {
    width: 108rpx;
    height: 108rpx;
    line-height: 108rpx;
    text-align: center;
    font-size: 60rpx;
    border-radius: 50%;
    background: #FFFDF7;
}

.me-copy { flex: 1; margin-left: 24rpx; }
.me-name { display: block; font-size: 34rpx; font-weight: 800; color: #FFFFFF; }
.me-sub { display: block; margin-top: 8rpx; font-size: 23rpx; color: #EEF6E6; }

.me-badge {
    padding: 10rpx 20rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.24);
    color: #FFFFFF;
    font-size: 22rpx;
}

.stat-grid {
    display: flex;
    margin: 24rpx 0;
    padding: 26rpx 0;
    border-radius: 30rpx;
    background: #FFFFFF;
    box-shadow: 0 8rpx 22rpx rgba(126, 110, 74, 0.07);
}

.stat { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 40rpx; font-weight: 800; color: #4E7A3E; }
.stat-warn { color: #E08B5A; }
.stat-ai { color: #7351A0; }
.stat-label { display: block; margin-top: 6rpx; font-size: 21rpx; color: #9C9284; }
.stat-link .stat-label { color: #7351A0; }

/* 已过期单独一行，颜色比「快过期」更重一点 */
.stat-note {
    margin: -6rpx 0 24rpx;
    padding: 16rpx 22rpx;
    border-radius: 20rpx;
    background: #FFF1EC;
    border: 2rpx solid #F3C3B7;
    font-size: 23rpx;
    color: #B4503A;
}

.card { margin-bottom: 24rpx; }

.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0 8rpx;
    margin-top: 8rpx;
    border-top: 2rpx solid #F3F0E5;
}

.setting-label { display: block; font-size: 27rpx; color: #4A4036; }
.setting-hint { display: block; margin-top: 6rpx; font-size: 21rpx; color: #A69C8B; }
.setting-arrow { font-size: 40rpx; color: #BDB3A1; }
/* 唯一一个会删数据的入口，颜色得和普通设置项区分开 */
.setting-danger { color: #B4503A; }

.about {
    margin: 8rpx 0 24rpx;
    text-align: center;
}

.about-logo { display: block; font-size: 30rpx; font-weight: 800; color: #6B7F55; }
.about-slogan { display: block; margin-top: 10rpx; font-size: 23rpx; color: #9C9284; }
.about-version { display: block; margin-top: 8rpx; font-size: 21rpx; color: #BDB3A1; }
