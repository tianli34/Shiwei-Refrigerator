<view class="page-wrap">

    <view wx:if="{{authState === 'checking'}}" class="loading-box">
        <text class="loading-dot">🍽️</text><text>正在翻冰箱…</text>
    </view>

    <view wx:elif="{{authState === 'signed-out'}}" class="auth-state">
        <view class="auth-head">
            <text class="auth-logo">🍽️</text>
            <text class="auth-title">今日推荐菜</text>
            <text class="auth-slogan">登录后才看得见你冰箱里的食材哦</text>
        </view>
        <login-panel bind:signedin="onSignedIn" />
        <text class="auth-error" wx:if="{{authError}}">{{authError}}</text>
    </view>

    <block wx:else>
        <view class="hero-card">
            <text class="hero-emoji">🍽️</text>
            <view class="hero-copy">
                <text class="hero-title">今日推荐菜</text>
                <text class="hero-sub">冰箱里有什么就先吃什么，越急的排越前</text>
            </view>
        </view>

        <view class="card" wx:if="{{viewState === 'error'}}">
            <text class="section-title">食材没取出来</text>
            <text class="section-sub">检查一下网络，或者回冰箱页看看。</text>
            <view class="btn-ghost" style="margin-top:24rpx" bindtap="onRetryData">重新加载</view>
        </view>

        <block wx:elif="{{viewState === 'loading'}}">
            <view class="loading-box"><text class="loading-dot">🥬</text><text>正在按保质期排队…</text></view>
        </block>

        <block wx:else>
            <!-- 筛选：临期阈值 N + 匹配范围 + 排序 -->
            <view class="card ctrl">
                <view class="ctrl-row">
                    <view class="ctrl-copy">
                        <text class="ctrl-title">先吃掉 {{days}} 天内到期的</text>
                        <text class="ctrl-sub">只留至少含 1 样这么急的食材的菜</text>
                    </view>
                    <view class="days-ctrl">
                        <view class="days-btn {{days <= daysMin ? 'days-btn-off' : ''}}" bindtap="onDaysMinus">−</view>
                        <text class="days-value">{{days}}</text>
                        <view class="days-btn {{days >= daysMax ? 'days-btn-off' : ''}}" bindtap="onDaysPlus">＋</view>
                    </view>
                </view>

                <view class="range-row">
                    <view class="range-btn {{full ? '' : 'range-on'}}" data-full="0" bindtap="onRangeTap">只推临期</view>
                    <view class="range-btn {{full ? 'range-on' : ''}}" data-full="1" bindtap="onRangeTap">全量匹配</view>
                </view>
                <text class="range-tip">{{full ? '排除过期食材后，冰箱里能做的全列出来' : '按上面的天数先消灭最急的'}}</text>

                <view class="sort-row">
                    <text class="sort-label">排序</text>
                    <view
                        wx:for="{{sorts}}"
                        wx:key="key"
                        class="sort-chip {{sort == item.key ? 'sort-on' : ''}}"
                        data-sort="{{item.key}}"
                        bindtap="onSortTap"
                    >{{item.label}}</view>
                </view>

                <text class="ctrl-stats">{{statsLine}}<text wx:if="{{expiredCount > 0}}"> · {{expiredCount}} 样已过期没算进来</text></text>
            </view>

            <block wx:if="{{noIngredient}}">
                <view class="card empty-state">
                    <text class="empty-emoji">🧊</text>
                    <text class="empty-title">冰箱还是空的</text>
                    <text class="empty-desc">先去冰箱页放几样食材，这里才有得推荐。</text>
                    <view class="btn-ghost" style="margin-top:24rpx" bindtap="goFridge">去放食材</view>
                </view>
            </block>

            <block wx:else>
                <view class="list-head">
                    <text class="list-title">{{showingFallback ? '🛒 只差一样就能开火' : '🏆 今晚推荐'}}</text>
                    <text class="list-count">{{listTotal}} 道</text>
                </view>
                <text class="list-tip" wx:if="{{showingFallback && listTotal > 0}}">按现在的食材一道现成的都凑不齐，补一样就能解锁下面这些。</text>

                <view
                    class="rank-card {{index < 3 ? 'rank-card-top' : ''}}"
                    wx:for="{{items}}"
                    wx:key="key"
                    data-key="{{item.key}}"
                    bindtap="onRecipeTap"
                >
                    <view class="rank-no {{index < 3 ? 'rank-no-top' : ''}}">{{item.rank}}</view>
                    <text class="rank-emoji">{{item.emoji}}</text>
                    <view class="rank-copy">
                        <view class="rank-line">
                            <text class="rank-name">{{item.name}}</text>
                            <text class="rank-cooked" wx:if="{{item.cookCount > 0}}">已做 {{item.cookCount}} 次</text>
                        </view>
                        <text class="rank-meta" wx:if="{{item.metaText}}">{{item.metaText}}</text>
                        <text class="rank-urgent {{item.hot ? 'rank-urgent-hot' : ''}}" wx:if="{{!showingFallback}}">⏰ {{item.daysText}}<text wx:if="{{item.urgentText}}"> · {{item.urgentText}}</text></text>
                        <text class="rank-approx" wx:if="{{item.approxText}}">🔁 {{item.approxText}}</text>
                        <text class="rank-need" wx:if="{{showingFallback}}">只差 <text class="rank-need-word">{{item.missingText}}</text></text>
                        <text class="rank-hint" wx:if="{{item.hintText}}">⚠️ {{item.hintText}}</text>
                    </view>
                    <view
                        wx:if="{{!showingFallback}}"
                        class="rank-act {{item.justCooked ? 'rank-act-on' : ''}}"
                        data-key="{{item.key}}"
                        catchtap="onMarkCook"
                    >{{item.justCooked ? '已记 ✓' : '已做 +1'}}</view>
                    <view wx:else class="rank-act rank-act-buy" data-name="{{item.missingRaw}}" catchtap="onAddMissing">＋买</view>
                </view>

                <view class="card empty-state" wx:if="{{listTotal == 0}}">
                    <text class="empty-emoji">🍳</text>
                    <text class="empty-title">按这些食材还凑不出菜</text>
                    <text class="empty-desc">把天数调大一点，或者切到「全量匹配」再看看。</text>
                </view>

                <view class="pager" wx:if="{{showTen || showAll || showCollapse}}">
                    <view class="pager-btn" wx:if="{{showTen}}" bindtap="onShowTen">显示 10 道</view>
                    <view class="pager-btn" wx:if="{{showAll}}" bindtap="onShowAll">显示全部 {{listTotal}} 道</view>
                    <view class="pager-btn pager-btn-ghost" wx:if="{{showCollapse}}" bindtap="onCollapse">收起</view>
                </view>
            </block>
        </block>
    </block>

    <!-- 已做之后顺手记一下库存：只是确认，不扣库存 -->
    <view class="cook-bar" wx:if="{{bar}}">
        <view class="cook-bar-head">
            <text class="cook-bar-title">{{bar.emoji}} 记下了「{{bar.name}}」+1</text>
            <text class="cook-bar-undo" catchtap="onUndoCook">撤销</text>
        </view>
        <text class="cook-bar-sub">库存没动，顺手记一下这几样还剩多少？</text>
        <view class="cook-bar-item" wx:for="{{bar.items}}" wx:key="key">
            <text class="cook-bar-emoji">{{item.emoji}}</text>
            <view class="cook-bar-copy">
                <text class="cook-bar-name">{{item.name}}</text>
                <text class="cook-bar-qty {{item.done || item.pick === 'little' ? 'cook-bar-qty-on' : ''}}">{{item.text}}</text>
            </view>
            <!-- 三个动作是一组单选：录过哪个就亮哪个，和筛选、排序的选中态同一套绿 -->
            <view class="cook-bar-acts">
                <text class="cook-act {{item.done ? 'cook-act-on' : ''}}" data-index="{{index}}" catchtap="onBarFinish">用完了</text>
                <text class="cook-act {{item.pick === 'little' ? 'cook-act-on' : ''}}" data-index="{{index}}" catchtap="onBarLittle">剩少量</text>
                <text class="cook-act cook-act-sub" data-index="{{index}}" catchtap="onBarEdit">改数量</text>
            </view>
        </view>
        <view class="cook-bar-close" catchtap="onBarClose">先这样</view>
    </view>

    <tab-bar current="alchemy" />

    <!-- 菜谱详情 -->
    <view class="mask" wx:if="{{detail}}" bindtap="closeDetail"></view>
    <view class="sheet" wx:if="{{detail}}">
        <view class="sheet-handle"></view>
        <text class="detail-emoji">{{detail.emoji}}</text>
        <text class="sheet-title">{{detail.name}}</text>
        <text class="sheet-sub" wx:if="{{detail.metaText}}">{{detail.metaText}}</text>
        <text class="cooked-note" wx:if="{{detail.cookCount > 0}}">这道菜已做过 {{detail.cookCount}} 次</text>
        <view class="detail-note" wx:if="{{detail.approxText}}">🔁 {{detail.approxText}}</view>
        <view class="detail-note detail-note-warn" wx:if="{{detail.hintText}}">⚠️ {{detail.hintText}}</view>
        <text class="field-label">用料</text>
        <text class="detail-need">{{detail.mainItemsText}}<text wx:if="{{detail.seasoningText}}">（调料：{{detail.seasoningText}}）</text></text>
        <text class="field-label">做法</text>
        <view class="detail-step" wx:for="{{detail.steps}}" wx:key="*this">
            <text class="step-no">{{index + 1}}</text>
            <text class="step-text">{{item}}</text>
        </view>
        <view class="btn-yellow" style="margin-top:30rpx" wx:if="{{detail.missing.length > 0}}" bindtap="onAddDetailMissing">🛒 缺的 {{detail.missingText}} 加入买菜篮</view>
        <view class="btn-primary" style="margin-top:20rpx" wx:if="{{detail.canCook}}" data-key="{{detail.key}}" bindtap="onMarkCook">今天做了这道 · 已做 +1</view>
        <view class="btn-ghost" style="margin-top:16rpx" bindtap="closeDetail">收起</view>
    </view>

    <qty-sheet
        visible="{{qtySheet.visible}}"
        name="{{qtySheet.name}}"
        value="{{qtySheet.value}}"
        bind:save="onQtySave"
        bind:close="onQtyClose"
    />
</view>
