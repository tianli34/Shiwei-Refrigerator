/* ---------- 开门 ----------
   门板是 fixed 的一层，盖住整页；下面就是真实库存页，不是另做一个「开屏页」。
   所以门只要 opacity 归零、撤掉这层 view，露出来的就是用户要看的冰箱。 */
.door-scene {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 100;
    perspective: 1800rpx;
    pointer-events: none;
}

/* 顶光：门一转开就亮，最后跟门一起收掉，不留一层黄罩子在页面上 */
.scene-lamp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background: radial-gradient(ellipse at 50% 4%, rgba(255, 242, 186, 0.9), rgba(255, 242, 186, 0) 62%);
}

.scene-mist {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    opacity: 0;
    background: radial-gradient(ellipse at 48% 94%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 68%);
}

/* 右侧门轴，正角度 rotateY 让左边的把手朝用户拉出来 */
.door-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    transform-origin: 100% 50%;
    backface-visibility: hidden;
    background:
        linear-gradient(90deg, rgba(120, 104, 70, 0.1) 0, rgba(120, 104, 70, 0) 7%),
        linear-gradient(105deg, #F9F5E8 0%, #F0E8D4 48%, #E3D8BE 100%);
    box-shadow: inset 20rpx 0 44rpx rgba(122, 106, 72, 0.07), inset -8rpx 0 26rpx rgba(122, 106, 72, 0.05);
}

/* 门板正面压出来的一圈内框，让整块门有厚度，不像一张纯色纸 */
.door-panel::after {
    content: '';
    position: absolute;
    left: 28rpx;
    right: 28rpx;
    top: 64rpx;
    bottom: 64rpx;
    border-radius: 24rpx;
    box-shadow: inset 0 0 0 3rpx rgba(150, 134, 98, 0.13);
}

.door-handle {
    position: absolute;
    left: 56rpx;
    top: 38%;
    width: 20rpx;
    height: 184rpx;
    border-radius: 999rpx;
    background: linear-gradient(180deg, #CCC0A0 0%, #AFA27C 100%);
    box-shadow: 3rpx 4rpx 14rpx rgba(92, 80, 52, 0.22);
}

/* 冰箱贴：门关着的时候唯一会说话的东西 */
.door-magnet {
    position: absolute;
    left: 104rpx;
    top: 168rpx;
    padding: 16rpx 26rpx;
    border-radius: 16rpx;
    background: #FFF3C9;
    color: #8A6C25;
    font-size: 24rpx;
    letter-spacing: 1rpx;
    transform: rotate(-4deg);
    box-shadow: 0 8rpx 18rpx rgba(140, 120, 80, 0.14);
}

/* 门上的品牌压字：不是贴纸，是门板压铸出来的字。
   所以不用底色、不用描边，只靠「上沿一道暗影 + 下沿一道高光」做出凹进去的厚度，
   颜色比门板深半档，远看是金属铭牌，近看还是这扇奶油色的门。
   位置放在右上：左侧留给把手和冰箱贴，两边各占一头，门才不显得偏。
   它贴着门轴（transform-origin 在右边），转门时不会被甩出画面，
   因此不像冰箱贴那样单独淡出，跟着门一起淡就行。 */
.door-logo {
    position: absolute;
    right: 104rpx;
    top: 172rpx;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

/* 中文是主标，英文是副标：只靠字号和透明度分层，不加分割线 ——
   门是奶油色大面，多一条线就多一道杂音。 */
.door-logo-cn {
    font-size: 44rpx;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 9rpx;
    /* 字距会落在最后一个字后面，把这一格补回去，右边缘才是真的对齐 */
    margin-right: -9rpx;
    color: #9E8B6A;
    text-shadow:
        0 1rpx 0 rgba(255, 253, 244, 1),
        0 -1rpx 1rpx rgba(90, 76, 44, 0.32);
}

.door-logo-en {
    margin-top: 12rpx;
    margin-right: -6rpx;
    font-size: 19rpx;
    line-height: 1;
    letter-spacing: 6rpx;
    color: #A8977A;
    opacity: 0.9;
    text-shadow: 0 1rpx 0 rgba(255, 253, 244, 0.9);
}

/* 门脚那道横线不要了：内框描边已经给了厚度，两条线叠在底部反而像划痕 */

/* 280ms 起转，1200ms 转完到 96°：0~280 静着让人看清这是扇门，然后才动。
   缓动不用「一出手就到 70°」的强 ease-out —— 门是绕右轴转的，角度一大就只剩一条边，
   实测那样真正看得见的转动只有 170ms，剩下的时间都在看空气。
   转动时长是「开门手感」唯一的旋钮：480ms 一晃就没了，700ms 能看清，
   880ms 像真的拉开一道缝，1200ms 是「慢慢拉、门轴还带点沉」的节奏（用户选定的档）。
   门全程 pointer-events: none，这段只是给人的，不是给操作的。 */
.door-scene-play .door-panel {
    animation: doorSwing 1200ms cubic-bezier(0.34, 0.16, 0.3, 1) 280ms both;
}

/* 灯光和门一起收（280 + 1560 = 1840），不能让整层撤掉时还剩一层黄罩子 */
.door-scene-play .scene-lamp {
    animation: lampGlow 1560ms ease-out 280ms both;
}

/* 雾在门后侧（z 低于门板），所以它得等门真的开出一道缝才浮出来：
   起点约在转动的 1/3 处（280 + 0.32 × 1200） */
.door-scene-play .scene-mist {
    animation: mistDrift 500ms ease-out 660ms both;
}

/* 冰箱贴贴得离门轴最远，透视一大就飞到屏幕外；让它跟门一起走，别在画面上飘 */
.door-scene-play .door-magnet {
    animation: magnetOut 140ms ease-out 280ms both;
}

@keyframes doorSwing {
    from { transform: rotateY(0deg); opacity: 1; }
    82%  { opacity: 1; }
    to   { transform: rotateY(96deg); opacity: 0; }
}

/* 亮起来 → 稳一下 → 在门撤掉之前先退干净，避免整层移除时「啪」地跳一下 */
@keyframes lampGlow {
    0%   { opacity: 0; }
    30%  { opacity: 0.85; }
    70%  { opacity: 0.55; }
    100% { opacity: 0; }
}

@keyframes mistDrift {
    0%   { opacity: 0; transform: translateY(16rpx); }
    35%  { opacity: 0.2; }
    100% { opacity: 0; transform: translateY(-26rpx); }
}

@keyframes magnetOut {
    to { opacity: 0; }
}

/* ---------- 食材回弹 ----------
   动的是食材本身（真实卡片里的 emoji），不是另摆一排替身；
   所以开门那一下看到的、弹的、点开的，永远是同一份库存。
   起点跟着门走：1460ms 门还剩最后一点角度，第一排正好露出来。 */
.shelf-bounce .food-emoji {
    transform-origin: 50% 95%;
    animation: shelfWobble 300ms ease-out 1460ms both;
}

.shelf-bounce .food-card-urgent .food-emoji,
.shelf-bounce .food-card-expired .food-emoji {
    animation-name: shelfRescue;
    animation-duration: 320ms;
}

.shelf-bounce .food-card:nth-child(2) .food-emoji { animation-delay: 1480ms; }
.shelf-bounce .food-card:nth-child(3) .food-emoji { animation-delay: 1500ms; }

/* 起跳 → 落地压扁 → 第二跳振幅减半，这点「果冻感」靠关键帧就够了，
   不需要运行时模拟弹簧，也不用逐帧 setData */
@keyframes shelfWobble {
    0%, 100% { transform: none; }
    28% { transform: translateY(-6rpx) rotate(-3deg); }
    62% { transform: rotate(2deg) scale(1.02, 0.98); }
}

@keyframes shelfRescue {
    0%, 100% { transform: none; }
    22% { transform: translateY(-18rpx) rotate(-5deg); }
    43% { transform: scale(1.07, 0.93); }
    65% { transform: translateY(-10rpx) rotate(3deg); }
    83% { transform: scale(1.03, 0.97); }
}

.head-row {
