    display: block;
    margin-bottom: 16rpx;
    font-size: 22rpx;
    line-height: 1.6;
    color: #A69C8B;
}

.receipt-box {
    position: relative;
    overflow: hidden;
    margin-top: 28rpx;
    padding: 48rpx 20rpx;
    text-align: center;
    border: 3rpx dashed #DCD3B8;
    border-radius: 28rpx;
    background: #FFFDF4;
}

.receipt-emoji { display: block; font-size: 76rpx; }
.receipt-title { display: block; margin-top: 16rpx; font-size: 30rpx; font-weight: 700; }
.receipt-sub { display: block; margin-top: 8rpx; font-size: 23rpx; color: #A69C8B; }

/* 识别中：小票图轻轻浮动、文案呼吸、虚线框内一道扫描光带 */
.receipt-busy .receipt-emoji { animation: receipt-float 1.5s ease-in-out infinite; }
.receipt-busy .receipt-title { animation: receipt-breath 1.5s ease-in-out infinite; }

.receipt-busy::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    height: 48rpx;
    background: linear-gradient(180deg, rgba(127, 176, 105, 0) 0%, rgba(127, 176, 105, 0.16) 55%, rgba(127, 176, 105, 0) 100%);
    animation: receipt-scan 1.8s ease-in-out infinite;
    pointer-events: none;
}

@keyframes receipt-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-10rpx) scale(1.05); }
}

@keyframes receipt-breath {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
}

@keyframes receipt-scan {
    0% { top: -48rpx; }
    100% { top: 100%; }
}

.parsed-list { margin-top: 4rpx; }

.parsed-item {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 2rpx solid #F1EDE0;
}

.parsed-emoji { font-size: 44rpx; }
.parsed-copy { flex: 1; margin-left: 16rpx; }
.parsed-name { display: block; font-size: 27rpx; font-weight: 600; }
.parsed-meta { display: block; margin-top: 4rpx; font-size: 21rpx; color: #A69C8B; }
.parsed-meta-fuzzy { color: #B9832B; }
.parsed-qty-edit { margin-left: 8rpx; color: #7FB069; }
.parsed-del { padding: 8rpx 18rpx; font-size: 36rpx; color: #C98D7C; }

/* 本次连续录入的小结，紧跟在「放进冰箱」按钮下方 */
.round-bar {
    margin-top: 24rpx;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    background: #F1F5E9;
}

.round-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.round-count { font-size: 26rpx; font-weight: 700; color: #4E7A3E; }
.round-actions { display: flex; align-items: center; }
.round-toggle { margin-right: 16rpx; font-size: 23rpx; color: #5F7A48; }

.round-done {
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    background: #7FB069;
    color: #FFFFFF;
    font-size: 23rpx;
}
