.family-hero {
    display: flex;
    align-items: center;
    padding: 32rpx;
    border-radius: 34rpx;
    background: linear-gradient(120deg, #F8D568, #F1BE63);
    box-shadow: 0 12rpx 28rpx rgba(226, 178, 72, 0.24);
}

.family-emoji { font-size: 68rpx; }
.family-copy { margin-left: 22rpx; }
.family-title { display: block; font-size: 32rpx; font-weight: 800; color: #6B5320; }
.family-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8B6C2C; }

.card { margin-top: 24rpx; }

.code-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24rpx;
    padding: 24rpx 28rpx;
    border-radius: 22rpx;
    background: #F1F6E9;
    border: 2rpx dashed #B9D19C;
}

.code-text {
    font-size: 42rpx;
    font-weight: 800;
    letter-spacing: 8rpx;
    color: #4E7A3E;
}

.code-copy {
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: #7FB069;
    color: #FFFFFF;
    font-size: 24rpx;
}

.share-item {
    padding: 22rpx;
    margin-top: 16rpx;
    border-radius: 22rpx;
    background: #FFFDF4;
    border: 2rpx solid #F0E8D2;
}

.share-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.share-title { font-size: 27rpx; font-weight: 700; }
.share-code { font-size: 22rpx; color: #A69C8B; letter-spacing: 2rpx; }

.share-actions { display: flex; margin-top: 18rpx; }

.share-act {
    flex: 1;
    margin-right: 12rpx;
    padding: 14rpx 0;
    text-align: center;
    border-radius: 16rpx;
    background: #F1F5E9;
    color: #4E7A3E;
    font-size: 22rpx;
}

.share-act:last-child { margin-right: 0; }

.share-button {
    line-height: 1.5;
    font-size: 22rpx;
    padding: 14rpx 0;
}

.hint-line {
    display: block;
    margin-top: 22rpx;
    font-size: 23rpx;
    color: #A69C8B;
}

.tip-card {
    margin-top: 24rpx;
    padding: 26rpx;
    border-radius: 26rpx;
    background: #EAF3DF;
}

.tip-title { display: block; font-size: 26rpx; font-weight: 700; color: #4E7A3E; }
.tip-text { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.7; color: #6B7F55; }

.vote-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 2rpx solid #F1EDE0;
}

.vote-name { font-size: 27rpx; font-weight: 600; }
.vote-count { font-size: 24rpx; color: #C97A24; font-weight: 700; }

.buy-list { display: flex; flex-wrap: wrap; }

.buy-chip {
    padding: 12rpx 22rpx;
    margin: 0 12rpx 12rpx 0;
    border-radius: 999rpx;
    background: #FFF0BE;
    color: #8A6C25;
    font-size: 24rpx;
}
