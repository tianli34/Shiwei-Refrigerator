.hero-card {
    display: flex;
    align-items: center;
    padding: 32rpx;
    border-radius: 34rpx;
    background: linear-gradient(120deg, #F8D568, #F3BE58);
    box-shadow: 0 12rpx 28rpx rgba(226, 178, 72, 0.26);
}

.hero-emoji { font-size: 68rpx; }
.hero-copy { margin-left: 22rpx; }
.hero-title { display: block; font-size: 36rpx; font-weight: 800; color: #6B5320; }
.hero-sub { display: block; margin-top: 8rpx; font-size: 23rpx; color: #8B6C2C; }

.card { margin-top: 24rpx; }

.pick-count {
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    background: #EAF3DF;
    color: #4E7A3E;
    font-size: 24rpx;
    font-weight: 700;
}

.pick-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 24rpx;
}

.pick {
    position: relative;
    box-sizing: border-box;
    width: 23%;
    margin: 0 2.6% 16rpx 0;
    padding: 18rpx 6rpx;
    text-align: center;
    border-radius: 22rpx;
    background: #F7F4EA;
    border: 2rpx solid transparent;
}

.pick:nth-child(4n) { margin-right: 0; }

.pick-on {
    background: #E9F3DE;
    border-color: #7FB069;
}

.pick-emoji { display: block; font-size: 46rpx; }
.pick-name { display: block; margin-top: 6rpx; font-size: 22rpx; color: #6B6151; }

.pick-check {
    position: absolute;
    right: 8rpx;
    top: 6rpx;
    width: 30rpx;
    height: 30rpx;
    line-height: 30rpx;
    border-radius: 50%;
    background: #7FB069;
    color: #FFFFFF;
    font-size: 20rpx;
}

.synth-btn {
    margin-top: 16rpx;
    height: 92rpx;
    line-height: 92rpx;
    text-align: center;
    border-radius: 26rpx;
    background: #7FB069;
    color: #FFFFFF;
    font-size: 31rpx;
    font-weight: 800;
    box-shadow: 0 8rpx 20rpx rgba(127, 176, 105, 0.28);
}

.result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 40rpx 4rpx 18rpx;
}

.result-count { font-size: 24rpx; color: #9C9284; }

.recipe-card {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 24rpx;
    margin-bottom: 16rpx;
    border-radius: 28rpx;
    background: #FFFFFF;
    border: 2rpx solid #E9F0DF;
    box-shadow: 0 8rpx 22rpx rgba(126, 110, 74, 0.07);
    animation: popIn 0.35s both;
}

.recipe-card-need { border-color: #F3E2BC; background: #FFFDF6; }

.recipe-emoji { font-size: 58rpx; }
.recipe-copy { flex: 1; margin-left: 20rpx; overflow: hidden; }
.recipe-name { display: block; font-size: 29rpx; font-weight: 700; }
.recipe-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #9C9284; }

.recipe-tags { display: flex; flex-wrap: wrap; margin-top: 10rpx; }

.recipe-tag {
    padding: 4rpx 14rpx;
    margin-right: 10rpx;
    border-radius: 999rpx;
    background: #F1F5E9;
    color: #6B7F55;
    font-size: 20rpx;
}

.recipe-badge {
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    background: #E7F2DA;
    color: #4E7A3E;
    font-size: 22rpx;
    font-weight: 700;
}

.recipe-need { display: block; margin-top: 8rpx; font-size: 23rpx; color: #A1752A; }
.need-word { font-weight: 700; color: #C97A24; }

/* 用别的部位顶上去（五花肉 代 猪肉）：能做，但要说清楚 */
.recipe-approx { display: block; margin-top: 8rpx; font-size: 21rpx; color: #5F8A54; line-height: 1.5; }

/* 部位不够（只有里脊肉，这道菜要五花肉）：做不成，得说清为什么 */
.recipe-hint { display: block; margin-top: 6rpx; font-size: 21rpx; color: #B0762A; line-height: 1.5; }

.detail-note {
    margin-top: 16rpx;
    padding: 16rpx 20rpx;
    border-radius: 16rpx;
    background: #F3F8EC;
    font-size: 23rpx;
    color: #4E7A3E;
    line-height: 1.6;
}

.detail-note-warn { background: #FFF6E6; color: #A1752A; }

.add-small {
    padding: 12rpx 18rpx;
    border-radius: 999rpx;
    background: #F8D568;
    color: #6B5320;
    font-size: 22rpx;
    font-weight: 700;
}

.ai-card {
    margin-top: 40rpx;
    padding: 30rpx;
    border-radius: 32rpx;
    background: linear-gradient(135deg, #EFE7FA, #F7F0FF);
    border: 2rpx solid #E4D8F2;
}

.ai-chip {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #DCC9F2;
    color: #7351A0;
    font-size: 21rpx;
    font-weight: 700;
}

.ai-btn {
    margin-top: 24rpx;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    border-radius: 24rpx;
    background: #9B77C9;
    color: #FFFFFF;
    font-size: 29rpx;
    font-weight: 700;
}

.ai-stream {
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 18rpx;
    background: rgba(255, 255, 255, 0.7);
    font-size: 22rpx;
    line-height: 1.7;
    color: #7A6A8C;
    word-break: break-all;
}

.ai-result {
    margin-top: 22rpx;
    padding: 26rpx;
    border-radius: 24rpx;
    background: #FFFFFF;
}

.ai-name { display: block; font-size: 33rpx; font-weight: 800; color: #5D4480; }
.ai-line { display: block; margin-top: 10rpx; font-size: 24rpx; color: #8B7A9E; line-height: 1.6; }
.ai-meta { display: block; margin-top: 10rpx; font-size: 22rpx; color: #A99CBA; }
.ai-step { display: block; margin-top: 12rpx; font-size: 24rpx; color: #6B6151; line-height: 1.6; }

.ai-actions { display: flex; margin-top: 24rpx; }

.ai-mini {
    flex: 1;
    margin-right: 14rpx;
    padding: 18rpx 0;
    text-align: center;
    border-radius: 18rpx;
    background: #F3ECFB;
    color: #7351A0;
    font-size: 24rpx;
    font-weight: 600;
}

.ai-mini:last-child { margin-right: 0; }
.ai-error { display: block; margin-top: 16rpx; font-size: 23rpx; color: #C4634C; }

.ai-saved-link {
    display: block;
    margin-top: 16rpx;
    text-align: center;
    font-size: 23rpx;
    color: #7351A0;
    font-weight: 600;
}

.detail-emoji { display: block; font-size: 80rpx; text-align: center; margin-bottom: 10rpx; }
.detail-need { display: block; font-size: 26rpx; line-height: 1.7; color: #6B6151; }

.detail-step {
    display: flex;
    align-items: flex-start;
    padding: 14rpx 0;
    border-bottom: 2rpx dashed #EFEADB;
}

.step-no {
    flex-shrink: 0;
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    border-radius: 50%;
    background: #E9F3DE;
    color: #4E7A3E;
    font-size: 22rpx;
    font-weight: 700;
}

.step-text { flex: 1; margin-left: 16rpx; font-size: 26rpx; line-height: 1.7; }
